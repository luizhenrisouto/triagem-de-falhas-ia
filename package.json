{
  "name": "triagem-de-falhas-ia",
  "version": "1.0.0",
  "description": "Triagem de falhas de teste com IA (n8n + Claude)",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "test:e2e": "playwright test",
    "fluxo:montar": "tsx scripts/montar-fluxo.ts",
    "n8n:local": "tsx scripts/montar-fluxo.ts && tsx scripts/subir-n8n.ts",
    "test:integracao": "tsx scripts/montar-fluxo.ts && vitest run --config vitest.integracao.config.ts"
  },
  "author": "Luiz Henri Souto",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "fast-xml-parser": "^5.12.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
